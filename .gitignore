.venv/
__pycache__/
*.pyc
.DS_Store
# rendered output (regenerable); keep final videos and review sheets out of git too
**/renders/
media/
# fonts are downloaded by `uv run python scripts/fonts.py sync` (pinned in assets/fonts/fonts.toml)
assets/fonts/*.otf
assets/fonts/*.part
# Per-video projects are working data, not part of the skill. Only the template and the
# workflow demo are tracked; keep other videos here (ignored) or in a separate repo.
projects/*
!projects/_template/
!projects/attention-demo/

# local editor / Claude Code settings
.vscode/
.claude/
